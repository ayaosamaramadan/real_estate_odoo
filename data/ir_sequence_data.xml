<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_real_estate_lease" model="ir.sequence" forcecreate="1">
            <field name="name">Real Estate Lease</field>
            <field name="code">real_estate.lease</field>
            <field name="prefix">LEASE/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="active" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_lease_payment" model="ir.sequence" forcecreate="1">
            <field name="name">Lease Payment</field>
            <field name="code">lease.payment</field>
            <field name="prefix">PAY/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="active" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
