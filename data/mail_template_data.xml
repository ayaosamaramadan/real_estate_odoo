<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_payment_upcoming" model="mail.template">
        <field name="name">Lease: Upcoming Payment Reminder</field>
        <field name="model_id" ref="model_real_estate_p_lease" />
        <field name="subject">Upcoming Rent Payment for {{ object.property_id.name }}</field>
        <field name="email_from">{{ object.property_id.agent_id.email_formatted or user.email_formatted }}</field>
        <field name="email_to">{{ object.tenant_id.email }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Dear <t t-out="object.tenant_id.name" />,<br /><br />
                    This is a reminder that rent for
                    <strong><t t-out="object.property_id.name" /></strong> is due on
                    <strong><t t-out="object.next_payment_date" /></strong>.<br /><br />
                    Amount due: <strong><t t-out="object.monthly_rent" /></strong><br /><br />
                    Please make the payment by the due date.<br /><br />
                    Best regards,<br />
                    Real Estate Management
                </p>
            </div>
        </field>
        <field name="auto_delete" eval="True" />
    </record>
</odoo>