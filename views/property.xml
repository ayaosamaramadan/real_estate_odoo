<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_tree" model="ir.ui.view">
        <field name="name">real.estate.property.tree</field>
        <field name="model">real_estate_p.property</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="price" string="Price" />
                <field name="available" string="Available" />
                <field name="property_type" string="Property Type" />
                <field name="description" string="Description" />
                <field name="agent_id" string="Agent" />
            </tree>
        </field>
    </record>

    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real.estate.property.form</field>
        <field name="model">real_estate_p.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="set_available" string="Mark as Available" type="object"
                        invisible="available" class="oe_highlight" />
                    <button name="set_unavailable" string="Mark as Unavailable" type="object"
                        invisible="not available" class="oe_highlight" />
                    <button name='change_property_type_to_office'
                        string='change prop type to office'
                        type='object'
                    />
                    <button name='update_description' string='update description' type='object' />
                    <button name="mark_as_occupied" string="Mark as Occupied" type="object"
                        invisible="not available" class="oe_highlight" />

                    <button name="get_agent_name" string="Update Description to Agent Name"
                        type="object"
                        class="oe_highlight" />

                    <button name="inc_deposit" string="Increase Deposit by 5000" type="object"
                        class="oe_highlight" />
                    <button name="inc_bedroom" invisible="not available" string="Add Bedroom"
                        type="object" class="oe_highlight" />

                           <button name="prop_summary" string="Property Summary" type="object" 
                        class="oe_highlight" />

                           <button name="action_export_excel" string="Download Excel Report" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="view_leases"
                            string="Leases"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o">
                            <field name="lease_count"
                                widget="statinfo"
                                string="Leases" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="available" string="Available" />
                            <field name="price" string="Price" />
                            <field name="deposit" string="Deposit" />
                            <field name="property_type" string="Property Type" />
                            <field name="agent_id" string="Agent" />
                            <field name="bedrooms" string="Bedrooms" />

                        </group>
                    </group>
                </sheet>
                <notebook>
                    <page string="Description">
                        <field name="description" />
                    </page>

                    <page string="Leases">
                        <field name="lease_ids">
                            <tree create="false">
                                <field name="name" />
                            </tree>
                        </field>
                    </page>

                </notebook>
            </form>
        </field>
    </record>

    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real_estate_p.property</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
        </field>
    </record>
</odoo>