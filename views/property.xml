<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_property_tree" model="ir.ui.view">
        <field name="name">real.estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="available" string="Available" />
                <field name="property_type" string="Property Type" />
            </tree>
        </field>
    </record>

    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real.estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="set_available" string="Mark as Available" type="object"
                        invisible="available" class="oe_highlight" />
                    <button name="set_unavailable" string="Mark as Unavailable" type="object"
                        invisible="not available" class="oe_highlight" />
                        <button name='change_property_type_to_office' 
                        string='change prop type to office'
                        type='object'

                        />
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="available" string="Available" />
                        <field name="property_type" string="Property Type" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
        </field>
    </record>
</odoo>