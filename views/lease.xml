<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lease_search" model="ir.ui.view">
        <field name="name">real_estate_p.lease.search</field>
        <field name="model">real_estate_p.lease</field>
        <field name="arch" type="xml">
            <search string="Search Leases">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state"/>
                <group expand="0" string="Group By">
                    <filter string="Property" name="group_by_property"
                        context="{'group_by': 'property_id'}"/>
                    <filter string="Tenant" name="group_by_tenant"
                        context="{'group_by': 'tenant_id'}"/>
                    <filter string="State" name="group_by_state"
                        context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_lease_tree" model="ir.ui.view">
        <field name="name">real_estate_p.lease.tree</field>
        <field name="model">real_estate_p.lease</field>
        <field name="arch" type="xml">
            <tree string="Leases">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_rent"/>
                <field name="deposit_paid"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_lease_form" model="ir.ui.view">
        <field name="name">real_estate_p.lease.form</field>
        <field name="model">real_estate_p.lease</field>
        <field name="arch" type="xml">
            <form string="Lease">
                <header>
                    <button name="send_reminder_email" type="object"
                        string="Send Payment Reminder" class="btn-primary"
                        icon="fa-envelope"/>
                    <button name="update_to_active" string="Activate"
                        invisible="state != 'draft'" type="object"
                        class="btn-primary"/>
                    <button name="update_to_draft" string="Make Draft"
                        invisible="state != 'active'" type="object"
                        class="btn-warning"/>
                    <button name="%(action_maintenance_request_wizard)d"
                        string="Maintenance Request" type="action"
                        context="{'default_lease_id': active_id}"
                        invisible="state != 'active'"/>
                    <button name="create_maintenance_request"
                        string="Create Maintenance Request" type="object"
                        invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group string="Payment Reminder">
                        <field name="next_payment_date"/>
                        <field name="last_reminder_sent" readonly="1"/>
                    </group>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tenant_id"/>
                            <field name="property_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="monthly_rent"/>
                            <field name="deposit_paid"/>
                        </group>
                        <group>
                            <field name="duration_month"/>
                            <field name="comp_is_active"/>
                            <field name="next_elec_recharge"/>
                            <field name="total_plumbing_cost"/>
                            <field name="total_electrical_cost"/>
                            <field name="total_air_condition_cost"/>
                            <field name="total_appliance_cost"/>
                            <field name="total_other_cost"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Maintenance Requests">
                            <field name="main_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="issue_type"/>
                                    <field name="description"/>
                                    <field name="urgency"/>
                                    <field name="assigned_to"/>
                                    <field name="scheduled_date"/>
                                    <field name="completion_date"/>
                                    <field name="actual_cost"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="amount"/>
                                    <field name="late_fee"/>
                                    <field name="late_fee_applied"/>
                                    <field name="total_amount"/>
                                    <field name="payment_date"/>
                                    <field name="payment_method"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_maintenance_request_form" model="ir.ui.view">
        <field name="name">real_estate_p.maintenance.request.form</field>
        <field name="model">real_estate_p.maintenance.request</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="lease_id"/>
                        <field name="tenant_id"/>
                        <field name="property_id"/>
                        <field name="issue_type"/>
                        <field name="urgency"/>
                        <field name="assigned_to"/>
                        <field name="scheduled_date"/>
                        <field name="completion_date"/>
                        <field name="actual_cost"/>
                    </group>
                    <field name="description"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_maintenance_request_tree" model="ir.ui.view">
        <field name="name">real_estate_p.maintenance.request.tree</field>
        <field name="model">real_estate_p.maintenance.request</field>
        <field name="arch" type="xml">
            <tree string="Maintenance Requests">
                <field name="name"/>
                <field name="lease_id"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="issue_type"/>
                <field name="urgency"/>
                <field name="assigned_to"/>
                <field name="scheduled_date"/>
                <field name="completion_date"/>
                <field name="actual_cost"/>
            </tree>
        </field>
    </record>

    <record id="action_maintenance_request" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">real_estate_p.maintenance.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_lease" model="ir.actions.act_window">
        <field name="name">Leases</field>
        <field name="res_model">real_estate_p.lease</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_lease_search"/>
    </record>

    <record id="ir_cron_auto_expire_leases" model="ir.cron">
        <field name="name">Real Estate: Auto Expire Leases</field>
        <field name="model_id" ref="model_real_estate_p_lease"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_expire_leases()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_send_upcoming_payment_reminders" model="ir.cron">
        <field name="name">Lease: Send Upcoming Email Reminders</field>
        <field name="model_id" ref="model_real_estate_p_lease"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_upcoming_payment_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
